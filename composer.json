{
	"name": "thrivedesk/wp-plugin",
	"authors": [
		{
			"name": "ThriveDesk"
		},
		{
			"name": "Rijoanul Hasan Shanto",
			"email": "rijoanul.shanto@gmail.com"
		},
		{
			"name": "Pronob Mozumder",
			"email": "pronobmozumder.info@gmail.com"
		}
	],
	"require": {},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0",
		"wp-phpunit/wp-phpunit": "^7.0",
		"squizlabs/php_codesniffer": "^3.13",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"config": {
		"platform": {
			"php": "7.4"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"autoload": {
		"psr-4": {
			"ThriveDesk\\": [
				"src/",
				"src/Abstracts",
				"Hooks/"
			]
		}
	},
	"scripts": {
		"phpcs": "phpcs",
		"test": "phpunit"
	}
}
