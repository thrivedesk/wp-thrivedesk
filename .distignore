# Files and folders to ignore when deploying to WordPress.org SVN

# Development and build files
/.wordpress-org
/.git
/.github
/node_modules
/scripts

# Build configuration files
package.json
package-lock.json
webpack.mix.js
tailwind.config.js
postcss.config.js
composer.lock

# Development tools
.gitignore
.gitattributes
.distignore
.editorconfig
.prettierrc.json
composer.json
phpcs.xml
phpcs-security.xml
phpcs-i18n.xml

# IDE and editor files
.vscode
.idea
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# Testing and CI files
phpunit.xml
phpunit.xml.dist
.phpunit.result.cache
tests/
/e2e
playwright.config.ts
playwright-report/
test-results/
.travis.yml
.circleci/
.codeclimate.yml

# Exclude readme.md since wp.org uses the generated readme.txt
readme.md
CHANGELOG.md
CONTRIBUTING.md

# Source files, all of them: assets/ is the built output the plugin loads
/resources

# Logs and temporary files
*.log
tmp/
temp/

# SVN directory (if present)
/svn

# Repo-only documentation
/docs
CLAUDE.md

# Local development bench (Docker). Never ships.
/docker
/plugins
