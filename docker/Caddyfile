# Two names for one site. thrivedesk.local is resolved by OrbStack itself, from
# the label on this service — no hosts file, no sudo, and port 443 on the
# container rather than a host port nobody can spare. thrivedesk.test is the
# fallback for other runtimes, and needs an /etc/hosts entry.
#
# Caddy issues this certificate from its own authority, kept in the caddy-data
# volume. `./td trust` installs that authority into the system keychain, which is
# what turns the padlock green and keeps the site a secure context — the thing
# localhost gave us for free and a bare http:// domain would take away.
thrivedesk.local, thrivedesk.test {
	tls internal

	reverse_proxy wordpress:80 {
		# Without this WordPress sees the container name as the host and
		# rewrites every URL to it.
		header_up Host {host}
		header_up X-Forwarded-Proto {scheme}
	}
}
